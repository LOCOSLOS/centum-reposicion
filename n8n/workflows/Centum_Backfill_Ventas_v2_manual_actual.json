                  {
                      "parameters":  {
                                         "jsCode":  "const ejecucion = $(\u0027Inicializa Ejecucion\u0027).first().json;\nconst ID_COMPARTIDA = 2;\n\nconst sucursales = [\n  { idSucursal: 6455, sucursalNombre: \u002701\u0027,                       idDivisionPropia: 1 },\n  { idSucursal: 6457, sucursalNombre: \u002702 - Local de Rivadavia\u0027, idDivisionPropia: 3 },\n  { idSucursal: 6084, sucursalNombre: \u002705 - Local de Monroe\u0027,    idDivisionPropia: 1 },\n  { idSucursal: 6761, sucursalNombre: \u002711 - Local de Gallardo\u0027,  idDivisionPropia: 3 },\n  { idSucursal: 6458, sucursalNombre: \u002716 - Local de Salguero\u0027,  idDivisionPropia: 1 },\n  { idSucursal: 8774, sucursalNombre: \u002717 - Local de Boedo\u0027,     idDivisionPropia: 1 },\n  { idSucursal: 9254, sucursalNombre: \u002718 - E-Commerce\u0027,         idDivisionPropia: 6 },\n  { idSucursal: 9258, sucursalNombre: \u002720 - Local Membrillar\u0027,   idDivisionPropia: 3 },\n  { idSucursal: 9261, sucursalNombre: \u002721 - Mayorista\u0027,          idDivisionPropia: 1 },\n  { idSucursal: 9281, sucursalNombre: \u002723 - Local Plaza Italia\u0027, idDivisionPropia: 1 },\n  { idSucursal: 9292, sucursalNombre: \u002724 - Local Doblas\u0027,       idDivisionPropia: 3 },\n  { idSucursal: 9302, sucursalNombre: \u002725 - Local Beltran\u0027,      idDivisionPropia: 1 },\n  { idSucursal: 9308, sucursalNombre: \u002726 - Local Parral\u0027,       idDivisionPropia: 1 }\n];\n\nconst consultas = [];\nfor (const sucursal of sucursales) {\n  for (const idDivision of [ID_COMPARTIDA, sucursal.idDivisionPropia]) {\n    consultas.push({\n      json: {\n        idEjecucion: ejecucion.idEjecucion,\n        fechaDesde: ejecucion.fechaDesde,\n        fechaHasta: ejecucion.fechaHasta,\n        idSucursal: sucursal.idSucursal,\n        sucursalNombre: sucursal.sucursalNombre,\n        idDivision\n      }\n    });\n  }\n}\n\nreturn consultas;"
                                     },
